{
  "expo": {
    "name": "StopMind!",
    "slug": "stopmind",
    "scheme": "stopmind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cxvone.stopmind",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "StopMind! necesita acceso a la cámara para escanear códigos QR y unirte a partidas en tu red WiFi.",
        "NSLocalNetworkUsageDescription": "StopMind! usa la red WiFi local para conectarte con otros jugadores sin internet.",
        "NSBonjourServices": [
          "_stopmind._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.cxvone.stopmind",
      "adaptiveIcon": {
        "backgroundColor": "#001C55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "StopMind! necesita acceso a la cámara para escanear códigos QR y unirte a partidas en tu red WiFi.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001C55",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ]
  }
}
