# URL HTTPS del backend desplegado en AWS (Output "ApiBaseUrl" de sam deploy)
# Ejemplo: EXPO_PUBLIC_API_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
EXPO_PUBLIC_API_URL=

# URL WSS/HTTPS de Cloudflare Workers + Durable Objects (apps/realtime) para Modo Online ($0)
# Ejemplo: EXPO_PUBLIC_ONLINE_WS_URL=wss://stopmind-realtime.tu-subdominio.workers.dev
EXPO_PUBLIC_ONLINE_WS_URL=
