# Desarrollo local únicamente (NUNCA subir .env real a Git)
NODE_ENV=development
PORT=4000
GEMINI_API_KEY=
LOG_PEPPER=dev-local-pepper-change-in-ssm
# En producción AWS se leen automáticamente desde SSM Parameter Store (SecureString KMS)
# SSM_GEMINI_KEY_PARAM=/stopmind/prod/gemini-api-key
# SSM_LOG_PEPPER_PARAM=/stopmind/prod/log-pepper
# DYNAMODB_TABLE_NAME=stopmind-api-cache
ALLOWED_ORIGINS=
RATE_LIMIT_MAX_PER_MINUTE=20
