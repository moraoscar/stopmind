# Copia este archivo como `.env.release.local` en la raíz del proyecto
# y completa tus credenciales locales.
# NUNCA subas `.env.release.local` ni archivos `.jks` / `.p8` a Git (están en .gitignore).

# ------------------------------------------------------------------------------
# ANDROID — Keystore de firma de producción (el mismo que usas en Android Studio)
# ------------------------------------------------------------------------------
ANDROID_KEYSTORE_PATH=~/keystores/stopmind-release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# ------------------------------------------------------------------------------
# iOS — Apple Developer Team + App Store Connect API Key (.p8)
# Cómo obtenerla: App Store Connect -> Usuarios y acceso -> Integraciones ->
#                 API de App Store Connect -> Generar clave (rol: Administrador o App Manager)
# ------------------------------------------------------------------------------
IOS_TEAM_ID=3NPWZ6L7JU
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
